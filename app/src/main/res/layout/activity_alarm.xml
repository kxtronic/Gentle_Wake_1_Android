<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_alarm.xml
    The full-screen alarm ringing view — dark with red accent.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <!-- Radial red pulse behind the icon -->
    <View
        android:id="@+id/pulseOuter"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/bg_alarm_pulse_outer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvWakeUp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/pulseInner"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_alarm_pulse_inner"
        app:layout_constraintTop_toTopOf="@id/pulseOuter"
        app:layout_constraintBottom_toBottomOf="@id/pulseOuter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivAlarmIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_alarm_bell"
        android:tint="@color/alarm_red"
        android:contentDescription="Alarm"
        app:layout_constraintTop_toTopOf="@id/pulseOuter"
        app:layout_constraintBottom_toBottomOf="@id/pulseOuter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvWakeUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WAKE UP"
        android:textColor="@color/text_primary"
        android:textSize="72sp"
        android:letterSpacing="0.12"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@id/pulseOuter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvAlarmRingTime"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvAlarmRingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/alarm_red"
        android:textSize="112sp"
        android:scaleX="0.5"
        android:letterSpacing="-0.02"
        app:layout_constraintBottom_toTopOf="@id/btnDismiss"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismiss"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="DISMISS"
        android:textSize="14sp"
        android:letterSpacing="0.14"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="56dp"
        app:cornerRadius="18dp"
        app:backgroundTint="@color/alarm_red"
        android:textColor="@color/text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
