<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_help.xml
    Help screen with usage tips.
    Replace the placeholder text inside each tvTipBody with your own content.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <!-- ── Top glow ──────────────────────────────────── -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_top_glow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Back button ───────────────────────────────── -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="@color/text_secondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:layout_marginStart="12dp"
        android:layout_marginTop="44dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Screen title ──────────────────────────────── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HELP"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.28"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Divider ────────────────────────────────────── -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/text_dim"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Scrollable tips area ───────────────────────── -->
    <ScrollView
        android:id="@+id/scrollHelp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <!-- ── TIP 1: Sound Setup ────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sound Setup"
                        android:textColor="@color/alarm_red"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTip1Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Before your first night, do a test run to make sure the alarm volume suits you. Set your phone volume to about halfway, set an alarm a couple of minutes ahead and let it run through a few chimes.\n\nDo not panic if the first chime is barely audible — Gentle Wake starts softly on purpose and increases volume with each ding. Adjust your phone volume up or down based on what you hear, then dismiss and reset the alarm for the morning."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── TIP 2: Permissions ────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Required Permission: Display Over Other Apps"
                        android:textColor="@color/alarm_red"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTip2Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gentle Wake needs permission to appear on top of other apps so it can show the wake-up screen even when your phone is locked or another app is open.\n\nThis permission is requested automatically the first time you launch the app. If you accidentally denied it, you can grant it manually:\n\n1. Open your phone\'s Settings app\n2. Go to Apps (or Application Manager)\n3. Find and tap Gentle Wake\n4. Tap Permissions or Special app access\n5. Tap Display over other apps\n6. Enable the toggle\n\nWithout this permission the alarm will still sound, but the wake-up screen may not appear while the phone is locked."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── TIP 3: Setting the Alarm ──────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Setting the Alarm"
                        android:textColor="@color/alarm_red"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTip3Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap the time display on the main screen to open the time picker. Choose your desired wake-up time and tap CONFIRM. Then flip the switch to arm the alarm — the time will turn red to confirm it is set."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── TIP 4: How the Alarm Sounds ───────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How the Alarm Sounds"
                        android:textColor="@color/alarm_red"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTip4Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gentle Wake plays up to 10 chimes with gradually increasing volume, starting very softly and reaching full volume by the last ding. The interval between chimes can be set in Settings — anywhere from 10 to 120 seconds — so you can choose how quickly or slowly the alarm escalates. At the default of 60 seconds the full sequence lasts 10 minutes."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── TIP 5: Dismissing the Alarm ───────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dismissing the Alarm"
                        android:textColor="@color/alarm_red"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTip5Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="When the alarm fires, tap DISMISS to silence it. If the alarm has completed all 10 chimes without being dismissed, the screen will show &quot;Alarm Expired&quot; so you know it did sound."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── TIP 6: Time Format ─────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Time Format"
                        android:textColor="@color/alarm_red"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTip6Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="You can switch between 12-hour and 24-hour display in the Settings screen. The choice applies to both the alarm time on the main screen and the current time shown when the alarm fires."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.5" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!--
                ══════════════════════════════════════════
                ADD MORE TIP CARDS BELOW HERE
                Copy any card block above, give it a new
                id (tvTip7Body etc.) and update the title
                and body text.
                ══════════════════════════════════════════
            -->

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
