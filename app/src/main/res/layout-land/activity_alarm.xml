<?xml version="1.0" encoding="utf-8"?>
<!--
    layout-land/activity_alarm.xml
    Landscape layout: bell + WAKE UP on the left, current time on the right.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <!-- ── LEFT COLUMN: bell icon + WAKE UP label ─────────────────────────── -->

    <!-- Pulse circles, constrained to left half -->
    <View
        android:id="@+id/pulseOuter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_alarm_pulse_outer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvWakeUp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.28" />

    <View
        android:id="@+id/pulseInner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_alarm_pulse_inner"
        app:layout_constraintTop_toTopOf="@id/pulseOuter"
        app:layout_constraintBottom_toBottomOf="@id/pulseOuter"
        app:layout_constraintStart_toStartOf="@id/pulseOuter"
        app:layout_constraintEnd_toEndOf="@id/pulseOuter"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.18" />

    <ImageView
        android:id="@+id/ivAlarmIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_alarm_bell"
        android:tint="@color/alarm_red"
        android:scaleType="fitCenter"
        android:contentDescription="Alarm"
        app:layout_constraintTop_toTopOf="@id/pulseOuter"
        app:layout_constraintBottom_toBottomOf="@id/pulseOuter"
        app:layout_constraintStart_toStartOf="@id/pulseOuter"
        app:layout_constraintEnd_toEndOf="@id/pulseOuter"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.10" />

    <!-- WAKE UP / Alarm Expired label, below the icon, left half -->
    <TextView
        android:id="@+id/tvWakeUp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="WAKE UP"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="22sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnDismiss"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline" />

    <!-- ── VERTICAL GUIDELINE at 48% ──────────────────────────────────────── -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.48" />

    <!-- ── RIGHT COLUMN: current time, vertically centred ─────────────────── -->
    <FrameLayout
        android:id="@+id/containerRingTime"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnDismiss"
        app:layout_constraintStart_toEndOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAlarmRingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text=""
            android:textColor="@color/current_time"
            android:textSize="72sp"
            android:scaleY="2.0"
            android:letterSpacing="-0.02" />

    </FrameLayout>

    <!-- ── DISMISS button at the bottom, full width ───────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismiss"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="DISMISS"
        android:textSize="13sp"
        android:letterSpacing="0.14"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="14dp"
        app:backgroundTint="@color/alarm_red"
        android:textColor="@color/text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
